  assert.equal((await readDueTutorReviews(db,{realm:"sites",userId:"other"},unit.courseId,seoulStudyDate(now))).length,0);
  await assert.rejects(db.prepare("UPDATE result_next_actions SET next_action='変更'").run(),/immutable/);
  await db.prepare("DROP TABLE review_schedule").run(); await assert.rejects(readDueTutorReviews(db,owner,unit.courseId,seoulStudyDate(now)),{code:"storage_failure"});
  console.log(JSON.stringify({status:"passed",environment:"local-workerd-d1",checks:["latest-confirmed-next-action","missing-next-action-explicit","corrected-next-action-and-recheck","stale-review-basis","seoul-date-boundary","owner-isolation","immutable-next-action","read-failure-not-empty"]}));
} finally {await runtime.dispose();}
