  const upload={id:uploadId,materialId,uploadId:id(),expectedHash:"a".repeat(64),bytes:6,recoveryAt:now};
  await reserveUpload(db,cmd(1),upload); await recordUploadObservation(db,cmd(1),upload,{objectKey:uploadObjectKey(upload),uploadId:upload.uploadId,hash:upload.expectedHash,bytes:6});
  await createPage(db,cmd(1),{id:pageId,materialId,uploadId,filePage:1,printedPage:null,content:"근거 문장"});
  await createSourceReference(db,cmd(1),{id:sourceId,materialId,uploadId,pageId,filePage:1,printedPage:null,spanStart:0,spanEnd:2,evidence:"근거"});
  const errorId=id(),reviewId=id(),correctionId=id();
  await createError(db,cmd(1),{id:errorId,unitId:unit.unitId,answerId,concept:"분수",description:"분모 의미"});
  await createReview(db,cmd(1),{id:reviewId,errorId,sourceRefId:sourceId,question:"이전 질문",explanation:"이전 설명",nextAction:"이전 행동"});
  await db.prepare("INSERT INTO review_schedule VALUES (?,?,1,?,?,1,?,?,NULL,?,'variable','pending')").bind(owner.userId,id(),id(),reviewId,questionId,versionId,"2026-10-25").run();
  assert.equal((await readDueTutorReviews(db,owner,unit.courseId,seoulStudyDate(now-1))).length,0);
  assert.equal((await readDueTutorReviews(db,owner,unit.courseId,seoulStudyDate(now))).length,1);
  await applyCorrection(db,cmd(1),{id:correctionId,errorId,concept:"분수",sourceRefId:sourceId,answerId,studyDate:"2026-10-25",createdAt:now,reason:"출처 확인",evidence:"근거",targets:[{reviewId,expectedVersion:1,question:"정정 질문",explanation:"정정 설명",nextAction:"정정 후 새 조건"}]});
  const reviews=await readCorrectedTutorReviews(db,owner,unit.courseId); const due=await readDueTutorReviews(db,owner,unit.courseId,seoulStudyDate(now));
