  await page.keyboard.press("ArrowRight");
  await expect(page.getByRole("tab", { name: "원본", exact: true })).toBeFocused();
  await expect(retained).toBeVisible();
  await page.keyboard.press("Space");
  await expect(page.getByRole("tab", { name: "원본", exact: true })).toHaveAttribute("aria-selected", "true");
  await expect(retained).not.toBeVisible();
  await retained.evaluate((element: HTMLInputElement): void => element.focus());
