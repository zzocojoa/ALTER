  await expect(page.getByLabel("나의 답안", { exact: true })).toHaveValue("분수는 전체의 일부입니다.\n");
  await page.getByRole("button", { name: "오류 표시", exact: true }).click();
  await expect(page.getByLabel("나의 답안", { exact: true })).toHaveAttribute("aria-invalid", "true");
  await expect(page.getByLabel("나의 답안", { exact: true })).toHaveAccessibleDescription(/설명과 예시를 함께 작성해 주세요/);
  await expect(page.locator("#answer--error")).toHaveText("설명과 예시를 함께 작성해 주세요.");
  await page.getByLabel("풀이 사진", { exact: true }).setInputFiles({ name: "시험용 풀이.png", mimeType: "image/png", buffer: Buffer.from("filename-only synthetic fixture") });
  await expect(page.getByLabel("선택한 파일", { exact: true })).toHaveText("시험용 풀이.png");
  await page.getByRole("button", { name: "답안 제출·저장", exact: true }).click();
  await page.locator("form").dispatchEvent("submit");
  await expect(page.getByLabel("제출 횟수", { exact: true })).toHaveText("1");
  await expect(page.getByRole("button", { name: "답안 제출·저장", exact: true })).toBeDisabled();
  await expect(page.getByRole("button", { name: "답안 제출·저장", exact: true })).toHaveAttribute("aria-busy", "true");
  await expect(page.getByLabel("AI 횟수", { exact: true })).toHaveText("0");
  await page.getByRole("button", { name: "별도 AI 동작", exact: true }).click();
  await expect(page.getByLabel("AI 횟수", { exact: true })).toHaveText("1");
