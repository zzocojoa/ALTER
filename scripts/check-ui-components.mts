  await expect(page.getByRole("button", { name: "자료 확인 열기", exact: true })).toBeFocused();
  await page.getByRole("button", { name: "자료 확인 열기", exact: true }).click();
  await expect(page.getByLabel("대화상자 초안", { exact: true })).toHaveValue("닫아도 보존할 초안");
  await page.mouse.click(2, 2);
  await expect(dialog).toBeVisible();
  const modalAxe = await new AxeBuilder({ page }).analyze();
  expect(modalAxe.violations).toEqual([]);
  await page.setViewportSize({ width: 402, height: 360 });
  const modalBounds = await dialog.boundingBox();
  expect(modalBounds).not.toBeNull();
  expect(modalBounds!.y).toBeGreaterThanOrEqual(0);
  expect(modalBounds!.y + modalBounds!.height).toBeLessThanOrEqual(361);
  await dialog.getByRole("button", { name: "닫기", exact: true }).click();
  await expect(dialog).toHaveCount(0);
  await expect(page.getByRole("button", { name: "자료 확인 열기", exact: true })).toBeFocused();
  await page.setViewportSize({ width: 320, height: 600 });
  await expect(page.locator("#save-unknown")).toHaveAttribute("data-persistence", "unconfirmed");
  await expect(page.locator("#save-unknown")).toContainText("아직 확인되지 않았어요");
  await expect(page.locator("#save-draft")).toContainText("답안 제출은 별도");
  await expect(page.locator("#save-submitted")).toContainText("AI 처리와 결과 확정은 별도");
  await expect(page.getByText("원화 청구 미확정", { exact: true })).toBeVisible();
  await page.setViewportSize({ width: 320, height: 360 });
  await page.evaluate((): void => { document.documentElement.style.fontSize = "200%"; });
  const actionBar = page.getByRole("group", { name: "답안 저장과 별도 요청", exact: true });
  await expect(actionBar).toHaveCSS("position", "static");
  await page.getByLabel("나의 답안", { exact: true }).focus();
  await page.getByRole("button", { name: "답안 제출·저장", exact: true }).scrollIntoViewIfNeeded();
  const submitBounds = await page.locator("#submit").boundingBox();
  expect(submitBounds).not.toBeNull();
  expect(submitBounds!.y).toBeGreaterThanOrEqual(0);
  expect(submitBounds!.y + submitBounds!.height).toBeLessThanOrEqual(361);
  expect(await page.evaluate((): boolean => document.documentElement.scrollWidth <= window.innerWidth)).toBe(true);
  await page.getByRole("button", { name: "답안 제출·저장", exact: true }).click();
  await expect(page.getByLabel("제출 횟수", { exact: true })).toHaveText("2");
  await expect(page.getByLabel("나의 답안", { exact: true })).toHaveValue("분수는 전체의 일부입니다.\n");
  const enlargedAxe = await new AxeBuilder({ page }).analyze();
  expect(enlargedAxe.violations).toEqual([]);
  await page.evaluate((): void => { document.documentElement.style.removeProperty("font-size"); });
  await page.setViewportSize({ width: 320, height: 600 });
  const axe = await new AxeBuilder({ page }).analyze();
  expect(axe.violations).toEqual([]);
  expect(await page.pageErrors()).toEqual([]);
  await mkdir("outputs/ui-components", { recursive: true });
  await page.screenshot({ path: "outputs/ui-components/fields-320.png", fullPage: true });
  const report = { status: "passed", sourceSha256: createHash("sha256").update(js + css).digest("hex"), fieldsAndActions: true, tabsAndDisclosureAndSegments: true, dialogFocusAndClose: true, saveStateBoundaries: true, normalFlowActionBar: true, shortViewportAnd200PercentText: true, modalAxeViolations: modalAxe.violations, syntheticIme: true, nativeFileSelectionOnly: true, rotationRetainsInput: true, axeViolations: axe.violations, requests, actualDevice: false, paidCalls: 0, externalWrites: 0 };
  await writeFile("outputs/ui-components/report.json", JSON.stringify(report, null, 2) + "\n");
  console.log(JSON.stringify(report));
} finally { await browser.close(); }
