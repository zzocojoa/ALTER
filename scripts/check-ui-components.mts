await build({ configFile: false, logLevel: "warn", resolve: { alias: { "@": resolve(".") } }, build: { outDir: ".sites-runtime/ui-components", emptyOutDir: true, copyPublicDir: false, lib: { entry: "tests/fixtures/ui-components.tsx", formats: ["iife"], name: "UiComponents", fileName: "fixture", cssFileName: "fixture" } }, define: { "process.env.NODE_ENV": JSON.stringify("production") }, esbuild: { jsx: "automatic" } });
