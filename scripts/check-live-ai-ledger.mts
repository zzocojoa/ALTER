import assert from "node:assert/strict";
import { readFile, writeFile } from "node:fs/promises";
import { normalizeAiUsage } from "../lib/ai/usage.ts";
import { calculateUsageCost, pricingFingerprint, pricingVersion } from "../lib/ai/pricing.ts";
import type { PricingVersion } from "../lib/ai/pricing.ts";
import { requireFundingSnapshot, fundingSnapshot, monthlyCommittedUnits } from "../lib/ai/funding.ts";
import type { FundingSnapshot } from "../lib/ai/funding.ts";

type LiveCall = Readonly<{ id: string; stage: string; http: number | null; responseId: string | null; requestId: string | null; usage: Readonly<{ model: string; status: string; usage: unknown }> | null }>;
type LiveFunding = Readonly<{ reservationId: string; checkedAt: number; snapshot: Omit<FundingSnapshot, "ownerId" | "accountFingerprint">; ownerMatches: boolean }>;
type LiveUsage = Readonly<{ reservation_id: string; actual_units: number; provider_receipt: string; occurred_at: number }>;
type LiveReservation = Readonly<{ id: string; state: string; actual_units: number | null }>;
type LivePricing = Readonly<{ id: string; fingerprint: string; snapshot: PricingVersion }>;
type LiveEvidence = Readonly<{ calls: readonly LiveCall[]; funding: readonly LiveFunding[]; usage: readonly LiveUsage[]; reservations: readonly LiveReservation[]; pricing: readonly LivePricing[]; summary: Readonly<{ cumulativeUsdMicros: number; unmatchedCalls: readonly string[]; settledMissingUsage: readonly string[] }> }>;

const evidencePath: string | undefined = process.argv[2];
if (!evidencePath) throw new Error("실제 운영 원장 증거 JSON 경로를 명시해 주세요.");
const input: LiveEvidence = JSON.parse(await readFile(evidencePath, "utf8")) as LiveEvidence;
const costs: readonly Readonly<{ id: string; expectedUnits: number; actualUnits: number; exactUsd: Readonly<{ numerator: string; denominator: string }> }>[] = await Promise.all(input.calls.filter((call: LiveCall): boolean => call.stage !== "unknown").map(async (call: LiveCall) => {
  const funding = input.funding.find((row: Readonly<{ reservationId: string }>): boolean => row.reservationId === call.id);
  assert.ok(funding, "호출의 결제 확인 증거 누락");
  const pricing = input.pricing.find((row: Readonly<{ id: string }>): boolean => row.id === funding.snapshot.pricingVersionId);
  const usage = input.usage.find((row: Readonly<{ reservation_id: string }>): boolean => row.reservation_id === call.id);
  const reservation = input.reservations.find((row: Readonly<{ id: string }>): boolean => row.id === call.id);
  assert.ok(pricing, "호출의 가격 버전 누락"); assert.ok(usage, "알려진 응답의 사용량 누락"); assert.ok(reservation, "호출의 비용 예약 누락"); assert.ok(call.usage, "응답 사용량 누락");
  assert.equal(call.usage.model, "gpt-6-luna"); assert.equal(call.http, 200); assert.ok(call.responseId); assert.ok(call.requestId);
  assert.equal(usage.provider_receipt, `response:${call.responseId}`);
  const settings = pricingVersion.parse(pricing.snapshot);
  assert.equal(await pricingFingerprint(settings), pricing.fingerprint);
  const amount = calculateUsageCost(normalizeAiUsage(call.usage.usage), settings, usage.occurred_at);
  assert.equal(amount.units, usage.actual_units); assert.equal(amount.units, reservation.actual_units); assert.equal(reservation.state, "settled");
  assert.equal(funding.ownerMatches, true);
  const snapshot = fundingSnapshot.parse({ ...funding.snapshot, ownerId: "audit-owner", accountFingerprint: "a".repeat(64) });
  requireFundingSnapshot(snapshot, "audit-owner", settings.id, funding.checkedAt);
  assert.equal(snapshot.automaticRecharge, false); assert.equal(snapshot.prepaidProbe?.additionalPurchasesAllowed, false);
  assert.equal(snapshot.prepaidProbe?.pendingPayment.krwStatus, "pending");
  assert.equal(monthlyCommittedUnits(snapshot, funding.checkedAt), 10_000_000_000);
  return { id: call.id, expectedUnits: amount.units, actualUnits: usage.actual_units, exactUsd: amount.exactUsd };
}));
assert.equal(new Set(input.calls.map((call: Readonly<{ id: string }>): string => call.id)).size, 27);
assert.equal(costs.length, 26); assert.equal(input.summary.cumulativeUsdMicros, 41730);
assert.equal(input.summary.unmatchedCalls.length, 0); assert.equal(input.summary.settledMissingUsage.length, 0);
const unknown = input.calls.filter((call: LiveCall): boolean => call.stage === "unknown");
assert.equal(unknown.length, 1); assert.ok(unknown[0].usage); assert.equal(unknown[0].usage.usage, null);
const unknownReservation = input.reservations.find((row: LiveReservation): boolean => row.id === unknown[0].id);
assert.ok(unknownReservation); assert.equal(unknownReservation.state, "unknown");
assert.equal(input.usage.some((row: Readonly<{ reservation_id: string }>): boolean => row.reservation_id === unknown[0].id), false);
const invalid = input.calls.find((call: LiveCall): boolean => call.stage === "invalid");
assert.ok(invalid); assert.ok(costs.some(cost => cost.id === invalid.id));
const report = { ...input, verification: { status: "passed", completedAt: new Date().toISOString(), knownUsageRecomputed: costs.length, allUsageAndReceiptJoinsMatch: true, fundingAndPricingValidAtHistoricalCall: true, cumulativeBoundUsd: "0.041730", remainingBoundUsd: "0.008270", unknownReservationRetained: true, invalidResponseCharged: true, additionalProviderCalls: 0, currentFundingObservation: "expired", providerBalanceEvidence: "providerBillingObservation", krwReconciliation: "pending" }, recalculatedCosts: costs };
await writeFile(evidencePath, JSON.stringify(report, null, 2) + "\n");
console.log(JSON.stringify(report.verification));
