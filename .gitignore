# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

# 로컬 검증 결과
/test-results/
/playwright-report/

# 설정 이름만 담은 예시는 소스에 포함합니다.
!.env.example

# 고정 의존성에서 빌드 시 복사하는 브라우저 PDF 자원
/public/pdfjs-*/

# 운영 증거와 로컬 Task Master 상태는 공개 소스에 넣지 않습니다.
/.taskmaster/*
!/.taskmaster/reports/
/.taskmaster/reports/*
!/.taskmaster/reports/.gitkeep
/review-artifacts/
