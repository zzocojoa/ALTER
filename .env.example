# 실제 값은 Sites의 비밀 환경값으로 설정합니다. 이 파일에는 값을 기록하지 않습니다.
ALTER_OWNER_USER_ID=
ALTER_SITE_ORIGIN=
ALTER_OWNER_ENROLLMENT_EXPIRES_AT=
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# 실제 가격·계정 자금·지원 검증 증거를 담은 서버 전용 JSON 설정입니다.
ALTER_AI_CONFIGURATION=

# Google 프로젝트·무료 조건·웹 OAuth의 검증된 서버 설정 JSON
ALTER_GOOGLE_ACCEPTANCE_ENABLED=
ALTER_GOOGLE_CONFIGURATION=
# GOOGLE_TOKEN_ENCRYPTION_KEY는 activeVersion과 keys 배열을 가진 JSON으로 설정합니다.

# 실제 프로젝트 quota와 Picker 키 제한 확인 근거
ALTER_GOOGLE_API_CONFIGURATION=
ALTER_GOOGLE_API_CONFIGURATION_1=
ALTER_GOOGLE_API_CONFIGURATION_2=
ALTER_GOOGLE_API_CONFIGURATION_3=
ALTER_GOOGLE_API_CONFIGURATION_4=
GOOGLE_PICKER_API_KEY=
